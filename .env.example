# Copy this file to .env and fill in real values from:
# Supabase dashboard > Project Settings > API (for the verified-home-inspector project)

PUBLIC_SUPABASE_URL=https://fxeksjzinggdhstplndp.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Analytics 4 measurement ID (G-XXXXXXXXXX) from the web data stream for
# verifiedhomeinspector.com. Optional: with it unset the site runs without
# analytics rather than breaking, which is what local checkouts should do.
# In production this is set as a Netlify environment variable, not here.
PUBLIC_GA_MEASUREMENT_ID=

# Netlify build hook URL (Site settings > Build & deploy > Build hooks).
# Lets scripts/set-tier.mjs --deploy publish a listing change without a code
# commit. Optional: without it the script still saves, and says the site needs
# a rebuild.
NETLIFY_BUILD_HOOK=

# Post-claim welcome email (netlify/functions/claim-welcome.mts). Both are set
# on Netlify, not here — nothing local sends email. RESEND_API_KEY is a key for
# the verifiedhomeinspector.com domain in Resend; CLAIM_WELCOME_SECRET is any
# long random string, pasted into the send_claim_welcome_on_claim trigger in
# supabase/migrations/2026-09-14-claim-welcome-email.sql when it is run.
RESEND_API_KEY=
CLAIM_WELCOME_SECRET=
