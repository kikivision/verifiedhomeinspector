---
// Netlify posts the inspector-request form here. Kept as a real page so a
// homeowner who has just sent their details knows the request went to one
// named inspector and not into a lead pool.
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Request sent | Verified Home Inspector"
  description="Your inspection request has been sent to the inspector you chose."
>
  <section class="section">
    <div class="wrap">
      <div class="claim">
        <div>
          <h1>Your request is on its way.</h1>
          <p>
            It went to the one inspector you picked, and to nobody else. Most reply within a
            business day. Every listing here comes straight from the Florida DBPR record, so you
            can send a request to another licensed inspector any time you want a second quote.
          </p>
        </div>
        {/* Defaults to the homepage and is upgraded to the county they came
            from by the script below. Hardcoded to Pinellas until now, which
            sent a homeowner in Orlando back to inspectors 100 miles away. */}
        <a href="/" class="btn-primary" id="backLink">Back to the directory</a>
      </div>
    </div>
  </section>
  <script>
    import { counties } from '../lib/counties';
    import { trackEvent } from '../lib/gtag';

    // Send them back to the county they were browsing, which arrives as ?from=
    // on the form action. Matched against the counties list rather than
    // interpolated: the value comes from the URL, so anything not a county we
    // actually publish is ignored and the link stays on the homepage.
    const from = new URLSearchParams(window.location.search).get('from');
    const county = counties.find((c) => c.slug === from && c.status === 'live');
    const backLink = document.querySelector<HTMLAnchorElement>('#backLink');
    if (county && backLink) {
      backLink.href = `/fl/${county.slug}/`;
      backLink.textContent = `Back to ${county.metro ?? county.name} inspectors`;
    }


    // This page is only reachable after a successful form post, so reaching it
    // means a homeowner actually sent an inquiry — not that they opened
    // the form and thought better of it. The button events on the county page
    // measure intent; this measures completion, and the gap between them is
    // the abandonment rate.
    trackEvent('request_submitted');
  </script>
</Layout>
