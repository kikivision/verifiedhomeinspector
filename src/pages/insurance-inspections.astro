---
// One statewide page, not one per county. The FAQ carries FAQPage schema, and
// the same schema on five URLs makes them compete with each other for the same
// query instead of one of them winning it. Nothing in the answers is
// county-specific — the statutes and the carrier rules are the same in Pinellas
// and Orange — so there is nothing four pages could have said that this one
// cannot.
//
// The point of this page is to reach an inspector, so the copy above the
// picker stays to a single paragraph. An earlier version carried four sections
// of researched detail about the wind mitigation form, statutory discount
// requirements, and what fails a 4-point. It was accurate as far as it went,
// but it buried the picker and it put a page of specific claims in front of
// readers that nobody here had independently checked. The FAQ below is where
// any detail belongs.
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import { counties } from '../lib/counties';

const live = counties.filter((c) => c.status === 'live');
---

<Layout
  title="4-Point and Wind Mitigation Inspections in Florida | Verified Home Inspector"
  description="What Florida insurers want at renewal: a 4-point on an older home and a wind mitigation for storm discounts, both from a DBPR-licensed home inspector."
>
  <section class="hero">
    <div class="wrap">
      <div class="county-tag">Insurance renewals</div>
      <h1>Switching your homeowner's insurance company?</h1>
      <p style="color:var(--navy-soft);font-weight:500;margin-top:10px;max-width:68ch;">
        Start with your insurance agent and ask them to shop other carriers for the same house.
        The carrier that quotes you will tell your agent what it needs, which commonly includes
        a 4-point inspection and a wind mitigation inspection. Licensed Florida home inspectors
        perform both.
      </p>
    </div>
  </section>

  <!-- The way to an inspector sits directly under the copy that explains why
       someone needs one, rather than below the FAQ. A reader who already knows
       they need a 4-point should not have to scroll past eight questions
       answering a question they no longer have. -->
  <section class="section" id="find-an-inspector" style="padding-top:8px;">
    <div class="wrap">
      <div class="section-head">
        <h2>Find a licensed inspector</h2>
        <div class="note">Every listing verified against the Florida DBPR record</div>
      </div>
      <p style="color:var(--slate);max-width:68ch;margin-top:0;">
        Requesting an inspector sends your details to that inspector and to nobody else. We never
        pass the same homeowner to several inspectors, and we never sell contact information.
      </p>
      <!-- A dropdown rather than a row of buttons: Florida has 67 counties and
           this list only grows. Live counties only — a county with no data yet
           has a "coming soon" page and no #all-inspectors section to land on,
           so offering it here would be a dead end from a button that promises
           inspectors. -->
      <div class="county-picker">
        <label class="visually-hidden" for="inspectorCountySelect">Choose your county</label>
        <select id="inspectorCountySelect">
          <option value="">Choose your county…</option>
          {live.map((c) => (
            <option value={c.slug}>{c.name}{c.metro ? ` · ${c.metro}` : ''}</option>
          ))}
        </select>
      </div>
    </div>
  </section>

  <Faq />

  <script>
    // Its own id: the header carries a #countySelect of its own, and two
    // elements sharing an id would leave one of them unwired.
    const select = document.getElementById('inspectorCountySelect') as HTMLSelectElement | null;
    select?.addEventListener('change', () => {
      if (!select.value) return;
      window.location.href = `/fl/${select.value}/#all-inspectors`;
    });
  </script>
</Layout>
