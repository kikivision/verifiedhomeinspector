---
import Layout from '../../../layouts/Layout.astro';
import FeaturedCard from '../../../components/FeaturedCard.astro';
import FeaturedDialog from '../../../components/FeaturedDialog.astro';
import ListingRows from '../../../components/ListingRows.astro';
import RequestDialog from '../../../components/RequestDialog.astro';
import { counties, getCounty, searchName } from '../../../lib/counties';
import { getListingsForCounty, type Listing } from '../../../lib/supabase';
import { cityPagesFor, cityPath } from '../../../lib/cities';

export function getStaticPaths() {
  return counties.map((c) => ({ params: { county: c.slug } }));
}

const { county: countySlug } = Astro.params;
const county = getCounty(countySlug!)!;
// county is guaranteed to exist here: getStaticPaths only ever generates
// pages for slugs in the counties.ts list, so an invalid slug simply
// never gets a page built for it (a real 404), rather than needing a
// runtime redirect that wouldn't work in a static-output build anyway.

// Static generation: this data is fetched at BUILD time, not on every
// page view. New or updated listings require a rebuild/redeploy to appear
// on the live site — same model as the other Astro/Netlify sites. If that
// stops being fast enough once claims/upgrades happen often, switching
// this route to Astro's server-rendered mode is the fix, not a rewrite.
const listings: Listing[] = county.status === 'live' ? await getListingsForCounty(county.slug) : [];

const featured = listings.filter((l) => l.tier === 'featured');
const nonFeatured = listings.filter((l) => l.tier !== 'featured');
// Cities actually present in the data, so the filter can never offer a city
// with nothing behind it.
const cities = [...new Set(nonFeatured.map((l) => l.city))].sort((a, b) => a.localeCompare(b));
// Cities with pages of their own — three or more listings; see lib/cities.ts.
const cityPages = cityPagesFor(county.slug, listings);
// Four featured spots on the county page, and the copy says "never more than
// four": an inspector buying one has to know they will not be one of twenty.
// The database allows positions up to 6 and .featured-grid is two columns, so
// any EVEN cap fills its rows; an odd one leaves a visible hole where a card
// should be. (A cap of 2 with a target of 4 was shown here for one day on
// 2026-09-12; the cap was always meant to be four.)
const FEATURED_CAP = 4;
const FEATURED_TARGET = 4;
// Never negative: a third paid card renders (Stripe can sell one before the
// cap moves), it just leaves no open-slot card behind it.
const openFeaturedSlots = Math.max(0, FEATURED_CAP - featured.length);
---

<Layout
  title={`${searchName(county)} Home Inspectors | Verified Home Inspector`}
  description={`Every licensed home inspector in ${searchName(county)}, Florida, from state DBPR records. Find one for a pre-purchase inspection, a 4-point, or a wind mitigation.`}
  currentCountySlug={county.slug}
>
  {county.status === 'coming_soon' ? (
    <section class="section">
      <div class="wrap">
        <div class="claim coming-soon-panel">
          <h1>{county.name} — coming soon</h1>
          <p>
            We're pulling licensed home inspector records for this county now. In the meantime,
            you can browse Pinellas County, which is fully live.
          </p>
          <a href="/fl/pinellas/" class="btn-primary">Browse Pinellas County instead</a>
        </div>
      </div>
    </section>
  ) : (
    <>
      <section class="hero" id="homebuyers">
        <svg class="hex-motif" width="300" height="280" viewBox="0 0 260 250" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="74,20 126,50 126,110 74,140 22,110 22,50" stroke="#1D2B3A" stroke-opacity="0.07" stroke-width="2"/>
          <polygon points="186,20 238,50 238,110 186,140 134,110 134,50" stroke="#1D2B3A" stroke-opacity="0.07" stroke-width="2"/>
          <polygon points="130,116 182,146 182,206 130,236 78,206 78,146" stroke="#1D2B3A" stroke-opacity="0.07" stroke-width="2"/>
        </svg>
        <div class="wrap hero-grid">
          <div>
            <div class="county-tag">{county.name}, FL</div>
            <h1>Find a licensed home inspector in {searchName(county)}</h1>
            <p style="color:var(--navy-soft);font-weight:500;margin-top:10px;">
              Before you close on a house, an inspection tells you the condition of the roof,
              structure, electrical, plumbing, and HVAC, which are the systems that cost the most
              to fix once the house is yours.
            </p>
          </div>
        </div>
      </section>

      <section class="section" id="browse">
        <div class="wrap">
          <div class="section-head">
            <h2>Featured inspectors</h2>
          </div>
          <div class="featured-grid">
            {featured.map((l) => (
              <FeaturedCard listing={l} county={county} pageContext={`county_${county.slug}_featured`} />
            ))}
            {Array.from({ length: openFeaturedSlots }).map(() => (
              <div class="card ad-slot">
                <h3 style="font-size:1rem;">This spot could be yours</h3>
                <p style="color:var(--slate);font-size:0.88rem;margin:0;">
                  {nonFeatured.length} licensed inspectors are listed in {county.name}. Featured
                  is one of {FEATURED_TARGET} spots above all of them — never more — and it
                  also puts your card at the top of up to three city pages you choose.
                </p>
                <button type="button" class="btn-primary featured-btn" data-county={county.slug} style="font-size:0.85rem;padding:8px 16px;">
                  Get featured
                </button>
              </div>
            ))}
          </div>
          <p class="disclosure">
            Featured spots are paid placements. Every listing here is verified against the
            Florida DBPR record, paid or not.
          </p>
        </div>
      </section>

      <FeaturedDialog county={county} listingCount={nonFeatured.length} />

      <section class="section" id="all-inspectors">
        <div class="wrap">
          <div class="section-head">
            <h2>All {nonFeatured.length} inspectors</h2>
          </div>

          <!-- The two controls do different jobs, and the placeholder says only
               what the text box is good at. City belongs to the dropdown: it is
               an exact match off a discoverable list, and typing a city here
               returns 100 rows for St. Petersburg, which is a filter rather than
               a search result. The text box is for narrowing to one person — an
               inspector finding their own row among three hundred, or a
               homeowner who already has a name or a license number. City stays
               in the search index so typing one still works; it just is not
               advertised as the way to do it. -->
          <div class="search-bar">
            <label class="visually-hidden" for="citySelect">Filter by city</label>
            <select id="citySelect">
              <option value="">All cities</option>
              {cities.map((c) => <option value={c}>{c}</option>)}
            </select>
            <label class="visually-hidden" for="listingSearch">Search listings</label>
            <input
              id="listingSearch"
              type="search"
              autocomplete="off"
              placeholder="Name or license"
            />
          </div>
          <div class="search-count" id="searchCount" aria-live="polite"></div>
          <ListingRows listings={nonFeatured} county={county} pageContext={`county_${county.slug}_table`} />
        </div>
      </section>

      <!-- Every city page is one click from here so a crawler finds them all,
           and a homeowner who knows their city can skip the 300-row table. -->
      <section class="section" id="cities" style="padding-top:0;">
        <div class="wrap">
          <div class="section-head">
            <h2>Browse by city</h2>
            <div class="note">Cities in {county.name} with three or more listed inspectors</div>
          </div>
          <div class="city-links">
            {cityPages.map((p) => (
              <a href={cityPath(county.slug, p.city)}>{p.city} <span>{p.listings.length}</span></a>
            ))}
          </div>
        </div>
      </section>

      <!-- The FAQ moved to /fl/<county>/insurance/. It used to render here, at
           95.7% of the way through a 246KB page, where the only thing below it
           was the claim form. This band sits directly under the listings
           instead, so a homeowner scrolling the directory meets the insurance
           story at the point they are already looking at inspectors. -->
      <section class="section" id="insurance-renewals">
        <div class="wrap">
          <div class="claim">
            <div>
              <div class="claim-eyebrow">For homeowners</div>
              <h2>Shopping for cheaper home insurance?</h2>
              <p>
                A carrier will usually ask for a 4-point inspection on an older home before it
                writes a policy, and a wind mitigation is what earns the storm-resistance
                discounts. Both are done by the same licensed inspectors listed above, and both
                come round again each time you change carrier.
              </p>
            </div>
            <a href="/insurance-inspections/" class="btn-primary">
              Insurance inspections explained
            </a>
          </div>
        </div>
      </section>

      <RequestDialog county={county} />

      <section class="section" id="claim">
        <div class="wrap">
          <div class="claim">
            <div>
              <div class="claim-eyebrow">For home inspectors</div>
              <h2>Own a home inspection business in {county.name}?</h2>
              <p>
                Your license is already listed here, straight from the DBPR record. Claiming it
                is free: it puts your business name, phone number, website and services on the
                listing, and moves you above every unclaimed inspector in the county. A featured
                spot above every listing is $50 a month at the founding rate, which the first
                inspectors to take one keep for as long as they stay.
              </p>
              {/* Deliberately NOT in faqItems. That array feeds the FAQPage
                  JSON-LD on the insurance page, and it is homeowner-intent
                  content aimed at search. Inspector questions in the same array
                  would enter the structured data and surface for queries we do
                  not want. This sits where inspectors already are instead. */}
              <div class="inspector-qa">
                <h3>How do homeowners contact me?</h3>
                <p>
                  Straight from your listing: your phone number dials and your website opens.
                  A homeowner who would rather write uses the request button, and that goes
                  to you and nobody else. We never send one homeowner to several inspectors,
                  and we never charge per lead.
                </p>
              </div>
            </div>
            <div class="claim-cta">
              <a href="/claim/" class="btn-primary">Claim your listing — free</a>
              <a href="/for-inspectors/" class="claim-more">What a claimed listing shows</a>
              <a href="/for-inspectors/#contact" class="claim-more">Don't see your business? Let us know.</a>
            </div>
          </div>
        </div>
      </section>
    </>
  )}

  <script>

    // Client-side filtering: all 317 rows are already in the HTML, so narrowing
    // them is a matter of hiding rows rather than fetching anything. Matching
    // runs against a data-search string built at render time, so a keystroke
    // never has to read text back out of the DOM.
    const search = document.querySelector<HTMLInputElement>('#listingSearch');
    const citySelect = document.querySelector<HTMLSelectElement>('#citySelect');
    const countEl = document.querySelector<HTMLElement>('#searchCount');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.list-row:not(.head)'));

    function applyFilters() {
      if (!search || !citySelect || !countEl) return;
      const term = search.value.trim().toLowerCase();
      const city = citySelect.value;
      let shown = 0;

      rows.forEach((row) => {
        const matchesCity = !city || row.dataset.city === city;
        const matchesTerm = !term || (row.dataset.search ?? '').includes(term);
        const visible = matchesCity && matchesTerm;
        row.hidden = !visible;
        if (visible) shown += 1;
      });

      if (!term && !city) {
        countEl.textContent = '';
      } else if (shown === 0) {
        countEl.textContent =
          'No inspectors match that search. Every licensed inspector on this page comes from the DBPR record, so try a license number or a surname.';
      } else {
        countEl.textContent = `Showing ${shown} of ${rows.length} listings.`;
      }
    }

    search?.addEventListener('input', applyFilters);
    citySelect?.addEventListener('change', applyFilters);

    // An inspector's page links to its city as /fl/<county>/?city=<City>.
    // Only a city the select already offers is honored: the value comes
    // from the URL, and anything else would leave the filter claiming a city
    // with no rows.
    const preset = new URLSearchParams(location.search).get('city');
    if (preset && citySelect && Array.from(citySelect.options).some((o) => o.value === preset)) {
      citySelect.value = preset;
      applyFilters();
    }

  </script>
</Layout>
