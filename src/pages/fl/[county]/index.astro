---
import Layout from '../../../layouts/Layout.astro';
import Faq from '../../../components/Faq.astro';
import { counties, getCounty } from '../../../lib/counties';
import { getListingsForCounty, type Listing } from '../../../lib/supabase';

export function getStaticPaths() {
  return counties.map((c) => ({ params: { county: c.slug } }));
}

const { county: countySlug } = Astro.params;
const county = getCounty(countySlug!)!;
// county is guaranteed to exist here: getStaticPaths only ever generates
// pages for slugs in the counties.ts list, so an invalid slug simply
// never gets a page built for it (a real 404), rather than needing a
// runtime redirect that wouldn't work in a static-output build anyway.

// Static generation: this data is fetched at BUILD time, not on every
// page view. New or updated listings require a rebuild/redeploy to appear
// on the live site — same model as the other Astro/Netlify sites. If that
// stops being fast enough once claims/upgrades happen often, switching
// this route to Astro's server-rendered mode is the fix, not a rewrite.
const listings: Listing[] = county.status === 'live' ? await getListingsForCounty(county.slug) : [];

const featured = listings.filter((l) => l.tier === 'featured');
const nonFeatured = listings.filter((l) => l.tier !== 'featured');
// Cities actually present in the data, so the filter can never offer a city
// with nothing behind it.
const cities = [...new Set(nonFeatured.map((l) => l.city))].sort((a, b) => a.localeCompare(b));
// Three, not six: six empty placeholders pushed the real names most of a screen
// further down, and an empty spot advertises the product far less well than a
// claimed one does. Raise this once enough spots are actually sold that the row
// looks occupied. The database allows positions up to 6, so raising it back is a
// one-line change with no migration.
const FEATURED_CAP = 3;
const openFeaturedSlots = FEATURED_CAP - featured.length;
---

<Layout
  title={`${county.name} Home Inspectors | Verified Home Inspector`}
  description={`Every licensed home inspector in ${county.name}, Florida, from state DBPR records. Find one for a pre-purchase inspection, a 4-point, or a wind mitigation.`}
  currentCountySlug={county.slug}
>
  {county.status === 'coming_soon' ? (
    <section class="section">
      <div class="wrap">
        <div class="claim coming-soon-panel">
          <h1>{county.name} — coming soon</h1>
          <p>
            We're pulling licensed home inspector records for this county now. In the meantime,
            you can browse Pinellas County, which is fully live.
          </p>
          <a href="/fl/pinellas" class="btn-primary">Browse Pinellas County instead</a>
        </div>
      </div>
    </section>
  ) : (
    <>
      <section class="hero" id="homebuyers">
        <svg class="hex-motif" width="300" height="280" viewBox="0 0 260 250" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="74,20 126,50 126,110 74,140 22,110 22,50" stroke="#1D2B3A" stroke-opacity="0.07" stroke-width="2"/>
          <polygon points="186,20 238,50 238,110 186,140 134,110 134,50" stroke="#1D2B3A" stroke-opacity="0.07" stroke-width="2"/>
          <polygon points="130,116 182,146 182,206 130,236 78,206 78,146" stroke="#1D2B3A" stroke-opacity="0.07" stroke-width="2"/>
        </svg>
        <div class="wrap hero-grid">
          <div>
            <div class="county-tag">{county.name}, FL</div>
            <h1>Find a licensed home inspector in {county.name}</h1>
            <p style="color:var(--navy-soft);font-weight:500;margin-top:10px;">
              Before you close on a house, an inspection tells you what condition it is really in
              and gives you room to renegotiate. Insurers want their own: a 4-point before they
              will write a policy, and a wind mitigation to apply the storm-resistance discounts.
            </p>
            <a href="#all-inspectors" class="btn-primary hero-cta">
              Contact a home inspector
            </a>
          </div>
        </div>
      </section>

      <section class="section" id="browse">
        <div class="wrap">
          <div class="section-head">
            <h2>Featured inspectors</h2>
          </div>
          <div class="featured-grid">
            {featured.map((l) => (
              <div class="card featured">
                <div class="badge">Featured</div>
                <div class="photo-strip">
                  <div class="avatar-slot">
                    {l.licensee_name.split(' ').map((n) => n[0]).slice(0, 2).join('')}
                  </div>
                  {l.photo_urls.length > 0 ? (
                    l.photo_urls.slice(0, 2).map((url) => <img src={url} alt="" class="photo-slot" />)
                  ) : (
                    <>
                      <div class="photo-slot">+ Add<br />photo</div>
                      <div class="photo-slot">+ Add<br />photo</div>
                    </>
                  )}
                </div>
                <h3>{l.business_name || l.licensee_name}</h3>
                <div class="city">{l.licensee_name} · {l.city}, FL</div>
                <div class="tags">
                  {l.specialties.length > 0 ? (
                    l.specialties.map((s) => <span class="tag">{s}</span>)
                  ) : (
                    <span class="tag">Licensed Home Inspector</span>
                  )}
                </div>
                <div class="cert-row">
                  {l.cert_badges.length > 0 ? (
                    l.cert_badges.map((c) => <span class="cert">{c}</span>)
                  ) : (
                    <span class="cert">+ Add certification</span>
                  )}
                </div>
                <div class="lic"><span class="check">✓</span>FL Lic #{l.license_number} — DBPR verified, active</div>
                <div class="contact">
                  <button class="request-btn" data-listing-id={l.id} data-page-context={`county_${county.slug}_featured`}>
                    Request this inspector
                  </button>
                </div>
              </div>
            ))}
            {Array.from({ length: openFeaturedSlots }).map((_, i) => (
              <div class="card ad-slot">
                <h3 style="font-size:1rem;">This spot could be yours</h3>
                <p style="color:var(--slate);font-size:0.88rem;margin:0;">
                  Above every free listing in {county.name}, on the page homeowners land on.
                </p>
                <a href="#claim" class="btn-primary" style="font-size:0.85rem;padding:8px 16px;">Get featured — $50/mo</a>
              </div>
            ))}
          </div>
          <p class="disclosure">
            Featured spots are paid placements. License status is verified against the Florida
            DBPR record for every inspector on this site, paid or not.
          </p>
        </div>
      </section>

      <section class="section" id="all-inspectors">
        <div class="wrap">
          <div class="section-head">
            <h2>All {county.name} inspectors</h2>
            <div class="note">{nonFeatured.length} more listings — free to claim, straight from DBPR license records</div>
          </div>

          <!-- The two controls do different jobs, and the placeholder says only
               what the text box is good at. City belongs to the dropdown: it is
               an exact match off a discoverable list, and typing a city here
               returns 100 rows for St. Petersburg, which is a filter rather than
               a search result. The text box is for narrowing to one person — an
               inspector finding their own row among three hundred, or a
               homeowner who already has a name or a license number. City stays
               in the search index so typing one still works; it just is not
               advertised as the way to do it. -->
          <div class="search-bar">
            <label class="visually-hidden" for="citySelect">Filter by city</label>
            <select id="citySelect">
              <option value="">All cities</option>
              {cities.map((c) => <option value={c}>{c}</option>)}
            </select>
            <label class="visually-hidden" for="listingSearch">Search listings</label>
            <input
              id="listingSearch"
              type="search"
              autocomplete="off"
              placeholder="Search by name or license number"
            />
          </div>
          <div class="search-count" id="searchCount" aria-live="polite"></div>
          <div class="list-row head">
            <div>Inspector</div><div>City</div><div>License</div><div>Specialties</div><div>Listing status</div><div>Hire</div>
          </div>
          <!-- Each unclaimed row's status cell links to the claim form. An
               inspector arrives looking for their own name and finds it here,
               ~20,000px above that form, so offering the claim on the row itself
               means they never go hunting for it, and the license number they
               just recognized is carried into the form for them. Without JS the
               link still jumps to #claim.

               This comment lives outside the map on purpose: inside it, Astro
               emitted it once per listing — 123KB on a 253KB page. -->
          {nonFeatured.map((l) => (
            <div
              class:list={['list-row', { 'is-claimed': l.tier !== 'unclaimed' }]}
              data-city={l.city}
              data-search={`${l.licensee_name} ${l.business_name ?? ''} ${l.city} ${l.license_number}`.toLowerCase()}
            >
              <div>
                <div class="name">{l.business_name || l.licensee_name}</div>
                <div class="role">
                  {l.business_name ? `${l.licensee_name} · ` : ''}Licensed home inspector
                </div>
              </div>
              <div>{l.city}</div>
              <div class="lic-num">{l.license_number}</div>
              <div class="tags">
                {l.specialties.length > 0 ? (
                  l.specialties.map((s) => <span class="tag">{s}</span>)
                ) : (
                  <span class="tag tag-empty">—</span>
                )}
              </div>
              {l.tier !== 'unclaimed' ? (
                <div class="claimed-status">
                  <span class="claimed-mark">Claimed</span>
                  <span class="claimed-note">Responds to requests</span>
                </div>
              ) : (
                <div>
                  <a href="#claim" class="claim-link" data-license={l.license_number} data-county={county.slug}>
                    Unclaimed <span>Is this you? Claim it</span>
                  </a>
                </div>
              )}
              <div>
                <button
                  class="request-btn-row"
                  data-listing-id={l.id}
                  data-license={l.license_number}
                  data-name={l.business_name || l.licensee_name}
                  data-page-context={`county_${county.slug}_table`}
                  data-county={county.slug}
                >
                  Request this inspector
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <Faq />

      <!-- One dialog serves all 317 rows: the inspector's identity is written into
           the hidden fields when a row's Request button is pressed. Netlify reads
           this form out of the built HTML the same way it reads the claim form,
           so an inquiry needs no mailbox on this domain either. -->
      <dialog id="requestDialog" class="request-dialog">
        <form
          name="inspector-request"
          method="POST"
          data-netlify="true"
          netlify-honeypot="referral-code"
          action="/request-received/"
        >
          <input type="hidden" name="form-name" value="inspector-request" />
          <input type="hidden" name="county" value={county.name} />
          <input type="hidden" name="inspector-license" id="requestLicense" />
          <input type="hidden" name="inspector-name" id="requestName" />
          <p class="visually-hidden">
            <label>Leave this field empty: <input name="referral-code" /></label>
          </p>

          <div class="request-head">
            <h2>Request an inspection</h2>
            <button type="button" class="request-close" id="requestClose" aria-label="Close">×</button>
          </div>
          <p class="request-who">
            Going to <strong id="requestWho"></strong>. This goes to that inspector only — your
            details are never sent to anyone else.
          </p>

          <label>
            Your name
            <input type="text" name="homeowner-name" required />
          </label>
          <label>
            Email
            <input type="email" name="homeowner-email" required />
          </label>
          <label>
            Phone
            <input type="tel" name="homeowner-phone" />
          </label>
          <label>
            Property city or ZIP
            <input type="text" name="property-location" />
          </label>
          <label>
            What you need
            <select name="inspection-type">
              <option value="Full home inspection">Full home inspection</option>
              <option value="4-point inspection">4-point inspection</option>
              <option value="Wind mitigation">Wind mitigation</option>
              <option value="Wind mitigation + 4-point">Wind mitigation and 4-point</option>
              <option value="Not sure yet">Not sure yet</option>
            </select>
          </label>
          <label>
            Anything else
            <textarea name="message" rows="3"></textarea>
          </label>
          <button type="submit" class="btn-primary">Send request</button>
        </form>
      </dialog>

      <section class="section" id="claim">
        <div class="wrap">
          <div class="claim">
            <div>
              <div class="claim-eyebrow">For home inspectors</div>
              <h2>Own a home inspection business in {county.name}?</h2>
              <p>
                Your license is already listed here, straight from the DBPR record. Claiming it
                puts your business name on the listing and moves you above every unclaimed
                inspector in the county, and it costs nothing until we have passed you five
                homeowner requests. Those arrive in your inbox, so you can count them yourself
                rather than take our word for it. After that it is $10/month, or $50/month for a
                featured spot above every free listing, and the first inspectors to take one keep
                that rate for as long as they stay. Every request goes to you and nobody else:
                we never send one homeowner to several inspectors, and we never charge per lead.
              </p>
            </div>
            <!-- Netlify picks this form up from the built HTML at deploy time and
                 emails each submission on, so claiming needs no mailbox on this
                 domain and no mail plan. A mailto would also have failed for any
                 inspector reading on a phone without a configured mail client,
                 which is most of them. -->
            <form
              name="claim-listing"
              method="POST"
              data-netlify="true"
              netlify-honeypot="company-website"
              action="/claim-received/"
              class="claim-form"
            >
              <input type="hidden" name="form-name" value="claim-listing" />
              <input type="hidden" name="county" value={county.name} />
              <!-- Named to look like a field a bot should fill and a person never
                   sees, so submissions that fill it can be discarded as spam. -->
              <p class="visually-hidden">
                <label>Leave this field empty: <input name="company-website" /></label>
              </p>

              <label>
                License number
                <input type="text" name="license-number" required placeholder="HI12345" />
              </label>
              <label>
                Your name
                <input type="text" name="licensee-name" required />
              </label>
              <label>
                Business name
                <input type="text" name="business-name" />
              </label>
              <label>
                Phone (so we can reach you)
                <input type="tel" name="phone" />
              </label>
              <label>
                Email
                <input type="email" name="email" required />
              </label>
              <label>
                What you want
                <!-- The value, not the label, is what lands in the notification
                     email and the CSV export, so each carries its price rather
                     than a bare slug like "featured". Plain hyphens and no em
                     dashes, since these are read in an inbox, not on the page. -->
                <select name="plan">
                  <option value="Claim - free until 5 requests, then $10/mo">
                    Claim my listing — free until 5 requests
                  </option>
                  <option value="Featured - $50/mo (founding rate)">Featured spot — $50/mo</option>
                  <option value="Not sure yet">Not sure yet, send me details</option>
                </select>
              </label>
              <button type="submit" class="btn-primary">Send</button>
            </form>
          </div>
        </div>
      </section>
    </>
  )}

  <script>
    import { logListingEvent } from '../../../lib/analytics';
    import { trackEvent } from '../../../lib/gtag';

    // Client-side filtering: all 317 rows are already in the HTML, so narrowing
    // them is a matter of hiding rows rather than fetching anything. Matching
    // runs against a data-search string built at render time, so a keystroke
    // never has to read text back out of the DOM.
    const search = document.querySelector<HTMLInputElement>('#listingSearch');
    const citySelect = document.querySelector<HTMLSelectElement>('#citySelect');
    const countEl = document.querySelector<HTMLElement>('#searchCount');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.list-row:not(.head)'));

    function applyFilters() {
      if (!search || !citySelect || !countEl) return;
      const term = search.value.trim().toLowerCase();
      const city = citySelect.value;
      let shown = 0;

      rows.forEach((row) => {
        const matchesCity = !city || row.dataset.city === city;
        const matchesTerm = !term || (row.dataset.search ?? '').includes(term);
        const visible = matchesCity && matchesTerm;
        row.hidden = !visible;
        if (visible) shown += 1;
      });

      if (!term && !city) {
        countEl.textContent = '';
      } else if (shown === 0) {
        countEl.textContent =
          'No inspectors match that search. Every licensed inspector on this page comes from the DBPR record, so try a license number or a surname.';
      } else {
        countEl.textContent = `Showing ${shown} of ${rows.length} listings.`;
      }
    }

    search?.addEventListener('input', applyFilters);
    citySelect?.addEventListener('change', applyFilters);

    // Opening the request dialog is the moment a homeowner shows intent in a
    // specific inspector, so it is logged here rather than on submit: it counts
    // interest even when someone abandons the form, which is the number worth
    // showing an inspector. The inquiry they actually receive is the paid
    // milestone, and that arrives by email, not from this table.
    const dialog = document.querySelector<HTMLDialogElement>('#requestDialog');
    const requestLicense = document.querySelector<HTMLInputElement>('#requestLicense');
    const requestName = document.querySelector<HTMLInputElement>('#requestName');
    const requestWho = document.querySelector<HTMLElement>('#requestWho');

    document.querySelectorAll<HTMLButtonElement>('.request-btn-row').forEach((btn) => {
      btn.addEventListener('click', () => {
        const { listingId, license, name, pageContext, county } = btn.dataset;
        if (!dialog || !requestLicense || !requestName || !requestWho) return;

        requestLicense.value = license ?? '';
        requestName.value = name ?? '';
        requestWho.textContent = `${name ?? 'this inspector'} (FL Lic #${license ?? ''})`;

        if (listingId) {
          logListingEvent(listingId, 'click_request', pageContext ?? 'unknown');
        }
        // Sent alongside the Supabase event rather than instead of it: Supabase
        // is the billing record tied to a listing id, GA4 is the traffic story.
        trackEvent('request_inspector', {
          license_number: license,
          inspector_name: name,
          county,
        });
        dialog.showModal();
      });
    });

    document.querySelector('#requestClose')?.addEventListener('click', () => dialog?.close());
    // Clicking the backdrop closes too: the dialog element itself is the click
    // target when the press lands outside the form.
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Carry the license number from the row an inspector recognized into the
    // claim form, so they are not asked to re-type what they just clicked.
    document.querySelectorAll<HTMLAnchorElement>('.claim-link').forEach((link) => {
      link.addEventListener('click', () => {
        const license = link.dataset.license;
        const field = document.querySelector<HTMLInputElement>('input[name="license-number"]');
        if (!license || !field) return;
        field.value = license;
        trackEvent('claim_listing', { license_number: license, county: link.dataset.county });
        // Focus has to wait out the current task: the browser is still resolving
        // the #claim jump as this handler runs, and focusing inside it gets reset
        // to body. A timer rather than requestAnimationFrame, because rAF is
        // suspended while a tab is in the background and would never fire.
        setTimeout(() => {
          const name = document.querySelector<HTMLInputElement>('input[name="licensee-name"]');
          name?.focus({ preventScroll: true });
        }, 0);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.request-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const listingId = btn.dataset.listingId;
        const pageContext = btn.dataset.pageContext || 'unknown';
        if (!listingId) return;

        logListingEvent(listingId, 'click_request', pageContext);
      });
    });
  </script>
</Layout>
