---
import Layout from '../layouts/Layout.astro';
import { counties, searchName } from '../lib/counties';
import { getListingCounts, getAllListings } from '../lib/supabase';
import { cityPagesFor, cityPath } from '../lib/cities';

// The root was a redirect to /fl/pinellas/ — an Astro redirect, which in a
// static build emits a noindex meta-refresh stub. Google confirmed it:
// "Excluded by 'noindex' tag". So the domain itself could never rank, including
// for its own brand name, and with a second county there was no longer one
// obvious place to send people.
const live = counties.filter((c) => c.status === 'live');
const comingSoon = counties.filter((c) => c.status !== 'live');
const counts = await getListingCounts(live.map((c) => c.slug));
const total = Object.values(counts).reduce((sum, n) => sum + n, 0);
// The three largest city pages per county, as links on the card. Listings are
// already read once per build for the county, city and inspector pages, so
// this costs nothing extra.
const all = await getAllListings(live.map((c) => c.slug));
const topCities = new Map(
  live.map((c) => [
    c.slug,
    cityPagesFor(c.slug, all)
      .sort((a, b) => b.listings.length - a.listings.length)
      .slice(0, 3)
      .map((p) => ({ name: p.city, path: cityPath(c.slug, p.city) })),
  ]),
);
---

<Layout
  title="Florida Home Inspectors | Verified Home Inspector"
  description="Every licensed home inspector in Florida, from state DBPR records. Browse by county for a pre-purchase inspection, a 4-point, or a wind mitigation."
>
  <!-- The header nav is shared and its links are in-page anchors: #homebuyers,
       #browse, #insurance-renewals, #claim. They exist on the county pages, so
       this page has to carry the same four or half the nav silently does
       nothing here. -->
  <section class="hero" id="homebuyers">
    <svg class="hex-motif" width="300" height="280" viewBox="0 0 260 250" fill="none" xmlns="http://www.w3.org/2000/svg">
      <polygon points="74,20 126,50 126,110 74,140 22,110 22,50" stroke="#1D2B3A" stroke-opacity="0.07" stroke-width="2"/>
      <polygon points="186,20 238,50 238,110 186,140 134,110 134,50" stroke="#1D2B3A" stroke-opacity="0.07" stroke-width="2"/>
      <polygon points="130,116 182,146 182,206 130,236 78,206 78,146" stroke="#1D2B3A" stroke-opacity="0.07" stroke-width="2"/>
    </svg>
    <div class="wrap hero-grid">
      <div>
        <div class="county-tag">Florida</div>
        <h1>Find a licensed home inspector in Florida</h1>
        <p style="color:var(--navy-soft);font-weight:500;margin-top:10px;">
          Before you close on a house, an inspection tells you the condition of the roof,
          structure, electrical, plumbing, and HVAC, which are the systems that cost the most
          to fix once the house is yours.
        </p>
        <p>
          Every inspector here holds a current Florida home inspector license, listed straight
          from state DBPR records. Pick your county to see who works in your area, what they
          specialize in, and how to reach them.
        </p>

        <!-- Statewide lookup. The list of 7,200 rows is fetched the first time
             the box is focused, not on page load, and matching happens here in
             the browser, so a keystroke never waits on the network. "Find an
             inspector" in the header points at #find and the script focuses
             the box. -->
        <div class="find" id="find">
          <label class="find-label" for="findInput">Already have a name or a license number?</label>
          <div class="search-bar find-bar">
            <input
              id="findInput"
              type="search"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
              placeholder="Name, business, or license number"
              aria-describedby="findCount"
              aria-controls="findResults"
              aria-expanded="false"
              aria-autocomplete="list"
              role="combobox"
            />
          </div>
          <div class="search-count" id="findCount" aria-live="polite"></div>
          <ul class="find-results" id="findResults" role="listbox" aria-label="Matching inspectors" hidden></ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="browse">
    <div class="wrap">
      <div class="section-head">
        <h2>Browse by county</h2>
        <div class="note">{total.toLocaleString()} licensed inspectors listed</div>
      </div>
      <div class="county-grid">
        {live.map((county) => (
          <div class="card county-card">
            {/* The card used to be one link. It holds city links now, and a
                link inside a link is invalid HTML, so the county link is the
                heading block and the cities are their own. */}
            <a class="county-card-main" href={`/fl/${county.slug}/`}>
              <h3>{searchName(county)}</h3>
              {/* Orlando and Tampa are what people search, but the county is the
                  precise fact and the only thing the data is keyed on, so a card
                  whose heading is a city still names the county underneath. */}
              <div class="city">{county.metro ? `${county.name}, FL` : 'Florida'}</div>
              <div class="county-count">{(counts[county.slug] ?? 0).toLocaleString()} licensed inspectors</div>
              <span class="view">Browse {searchName(county)} &rarr;</span>
            </a>
            {(topCities.get(county.slug) ?? []).length > 0 && (
              <div class="county-card-cities">
                {(topCities.get(county.slug) ?? []).map((c) => (
                  <a href={c.path}>{c.name}</a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
      {comingSoon.length > 0 && (
        <p class="note" style="margin-top:16px;color:var(--slate);font-size:0.88rem;">
          Coming soon: {comingSoon.map((c) => c.name).join(', ')}.
        </p>
      )}
    </div>
  </section>

  <!-- The FAQ moved to /insurance-inspections/. Two pages carrying the same
       FAQPage schema compete with each other for the same query rather than
       one of them winning it, so it lives on exactly one URL now. -->
  <section class="section" id="insurance-renewals">
    <div class="wrap">
      <div class="claim">
        <div>
          <div class="claim-eyebrow">For homeowners</div>
          <h2>Shopping for cheaper home insurance?</h2>
          <p>
            A carrier will usually ask for a 4-point inspection on an older home before it writes
            a policy, and a wind mitigation is what earns the storm-resistance discounts. Both
            are done by the same licensed inspectors listed here, and both come round again each
            time you change carrier.
          </p>
        </div>
        <a href="/insurance-inspections/" class="btn-primary">Insurance inspections explained</a>
      </div>
    </div>
  </section>

  <section class="section" id="claim">
    <div class="wrap">
      <div class="claim coming-soon-panel">
        <div class="claim-eyebrow">For home inspectors</div>
        <h2>Own a home inspection business in Florida?</h2>
        <p style="max-width:52ch;">
          Your license is already listed here, straight from the DBPR record. Claiming it is
          free: it puts your business name, phone number, website and services on the listing
          and moves you above every unclaimed inspector in your county. Featured spots are $50
          a month at the founding rate.
        </p>
        <div class="claim-counties">
          <a href="/claim/">Claim your listing</a>
          <a href="/for-inspectors/">What you get</a>
        </div>
      </div>
    </div>
  </section>
  <script>
    import { inspectorPath } from '../lib/slug';
    import { trackEvent } from '../lib/gtag';

    type Row = [string, string, string, string, string, number];
    interface Entry { row: Row; hay: string; license: string; name: string; path: string }

    const input = document.querySelector<HTMLInputElement>('#findInput');
    const countEl = document.querySelector<HTMLElement>('#findCount');
    const list = document.querySelector<HTMLUListElement>('#findResults');
    const MAX = 12;

    // Letters and digits only, one space between words, accents dropped, so
    // "O'Brien", "obrien" and "O Brien" are the same search, and "HI-11454",
    // "hi 11454" and "11454" all reach the same license.
    function norm(text: string): string {
      return text
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/&/g, ' and ')
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();
    }

    let entries: Entry[] | null = null;
    let loading: Promise<void> | null = null;
    let countyNames: Record<string, string> = {};
    let failed = false;

    function load(): Promise<void> {
      if (loading) return loading;
      loading = fetch('/search-index.json')
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json();
        })
        .then((data: { counties: Record<string, string>; rows: Row[] }) => {
          countyNames = data.counties;
          entries = data.rows.map((row) => {
            const [license, name, business, city, county] = row;
            const digits = license.replace(/\D/g, '');
            return {
              row,
              license,
              name,
              path: inspectorPath(county, city, license, name),
              hay: ` ${norm(`${name} ${business} ${city} ${countyNames[county] ?? county} ${license} ${digits}`)} `,
            };
          });
        })
        .catch(() => {
          failed = true;
          loading = null;
        });
      return loading;
    }

    function setCount(text: string) {
      if (countEl) countEl.textContent = text;
    }

    function clearResults() {
      if (!list || !input) return;
      list.innerHTML = '';
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
    }

    function optionAt(i: number): HTMLElement | undefined {
      return list?.children[i] as HTMLElement | undefined;
    }

    let active = -1;
    function setActive(i: number) {
      if (!list || !input) return;
      const n = list.children.length;
      active = n === 0 ? -1 : ((i % n) + n) % n;
      Array.from(list.children).forEach((li, idx) => {
        li.classList.toggle('is-active', idx === active);
        li.setAttribute('aria-selected', String(idx === active));
      });
      const el = optionAt(active);
      if (el) {
        input.setAttribute('aria-activedescendant', el.id);
        el.scrollIntoView({ block: 'nearest' });
      }
    }

    function render(matches: Entry[], total: number, term: string) {
      if (!list || !input) return;
      list.innerHTML = '';
      matches.forEach((e, i) => {
        const [license, name, business, city, county, flags] = e.row;
        const li = document.createElement('li');
        li.id = `findOption${i}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');
        const a = document.createElement('a');
        a.href = e.path;
        const title = document.createElement('span');
        title.className = 'find-name';
        title.textContent = business && business.toLowerCase() !== name.toLowerCase() ? `${business} · ${name}` : name;
        const meta = document.createElement('span');
        meta.className = 'find-meta';
        const status = flags & 1 ? 'Claimed listing' : flags & 2 ? 'Phone on page' : 'Not yet claimed';
        meta.textContent = `${city}, ${countyNames[county] ?? county} · ${license} · ${status}`;
        a.append(title, meta);
        a.addEventListener('click', () => {
          trackEvent('home_search_open', { license, term_length: term.length, position: i + 1 });
        });
        li.appendChild(a);
        list.appendChild(li);
      });
      list.hidden = matches.length === 0;
      input.setAttribute('aria-expanded', String(matches.length > 0));
      active = -1;
      input.removeAttribute('aria-activedescendant');
      if (matches.length === 0) {
        setCount('No listed inspector matches that. Every name here comes from the state license roll, so try just the last name, or the license number on their report. Or pick a county below.');
        trackEvent('home_search_empty', { term_length: term.length });
      } else if (total > matches.length) {
        setCount(`Showing the first ${matches.length} of ${total} matches. Keep typing to narrow it down.`);
      } else {
        setCount(matches.length === 1 ? '1 match. Press Enter to open it.' : `${matches.length} matches.`);
      }
    }

    function search() {
      if (!input) return;
      const term = norm(input.value);
      if (term.length < 2) {
        clearResults();
        setCount(term.length === 1 ? 'Keep typing.' : '');
        return;
      }
      if (failed) {
        clearResults();
        setCount('The search list did not load. Pick your county below; every inspector is on those pages.');
        return;
      }
      if (!entries) {
        setCount('Loading the list…');
        load().then(search);
        return;
      }
      const tokens = term.split(' ');
      const digits = term.replace(/\D/g, '');
      const scored: { e: Entry; score: number }[] = [];
      for (const e of entries) {
        if (!tokens.every((t) => e.hay.includes(t))) continue;
        let score = 0;
        const licDigits = e.license.replace(/\D/g, '');
        if (digits && licDigits === digits) score += 100;
        else if (digits && licDigits.startsWith(digits)) score += 40;
        const n = norm(e.name);
        if (n === term) score += 80;
        else if (n.startsWith(term)) score += 50;
        else if (tokens.every((t) => (` ${n} `).includes(` ${t}`))) score += 30;
        // On a tie, a claimed page outranks one with a public number, which
        // outranks a bare state record: the one with the most to read comes first.
        if (e.row[5] & 1) score += 8;
        else if (e.row[5] & 2) score += 5;
        scored.push({ e, score });
      }
      scored.sort((a, b) => b.score - a.score || a.e.name.localeCompare(b.e.name));
      render(scored.slice(0, MAX).map((x) => x.e), scored.length, term);
    }

    input?.addEventListener('focus', () => { load(); });
    input?.addEventListener('pointerenter', () => { load(); }, { once: true });
    input?.addEventListener('input', search);
    input?.addEventListener('keydown', (event) => {
      if (!list || list.hidden) return;
      if (event.key === 'ArrowDown') { event.preventDefault(); setActive(active + 1); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); setActive(active - 1); }
      else if (event.key === 'Enter') {
        const el = optionAt(active >= 0 ? active : 0)?.querySelector('a');
        if (el) { event.preventDefault(); el.click(); }
      } else if (event.key === 'Escape') { clearResults(); setCount(''); }
    });
    // A phone keyboard's "search" key is Enter; the browser's own clear (x)
    // on a search input fires "input" with an empty value, handled above.

    // "Find an inspector" in the header points here. Land with the box ready
    // to type in, on the first load and on a click while already on the page.
    function focusIfAsked() {
      if (location.hash === '#find' && input) {
        input.focus({ preventScroll: true });
        input.scrollIntoView({ block: 'center' });
      }
    }
    window.addEventListener('hashchange', focusIfAsked);
    focusIfAsked();
  </script>
</Layout>
