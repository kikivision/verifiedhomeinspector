---
import { faqItems } from '../lib/faq';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<section class="section" id="insurance-renewals">
  <div class="wrap">
    <div class="section-head">
      <h2>Common questions</h2>
      <div class="note">Wind mitigation and 4-point inspections, explained</div>
    </div>
    <!-- This sentence used to open the hero, where it was the back half of a
         nine-line paragraph a phone had to scroll past before showing a single
         inspector. It says what the questions below answer, so it earns its
         space here and costs nothing at the top of the page. -->
    <p class="faq-lead">
      Insurers want their own reports, so a carrier will usually ask for a 4-point on an older
      home before it will write a policy, and for a wind mitigation to apply the storm-resistance
      discounts.
    </p>
    <div class="faq">
      {faqItems.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
          {/* The schema above carries the answer as plain text, which is what
              an answer engine wants. The links live here instead, so a reader
              can check a claim without the citation ending up inside the
              structured data as markup. */}
          {item.sources && (
            <p class="faq-sources">
              Source:{' '}
              {item.sources.map((src, n) => (
                <>
                  {n > 0 && <span>, </span>}
                  <a href={src.url} rel="noopener">{src.label}</a>
                </>
              ))}
            </p>
          )}
        </details>
      ))}
    </div>
  </div>
</section>
