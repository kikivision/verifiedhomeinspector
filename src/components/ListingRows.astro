---
// The table of plain listings: the header row and one row per inspector.
// Shared by the county page and the city pages, so a claimed row shows the
// same contact and an unclaimed row offers the same claim on both.
//
// Comments inside the loop are JSX comments. The one HTML comment below sits
// outside it on purpose: inside it, Astro emitted it once per listing — 123KB
// on a 253KB page.
import type { County } from '../lib/counties';
import { isClaimed, websiteLabel, type Listing } from '../lib/supabase';
import { inspectorPath } from '../lib/slug';

interface Props {
  listings: Listing[];
  county: County;
  /** 'county_pinellas_table', 'city_pinellas_largo_table'. */
  pageContext: string;
}

const { listings, county, pageContext } = Astro.props;
---

<div class="list-row head">
  <div>Inspector</div><div>City</div><div>License</div><div>Specialties</div><div>Contact</div><div>Hire</div>
</div>
<!-- Each unclaimed row links straight to sign-in with its license number in
     the URL. An inspector arrives looking for their own name and finds it
     here, so the claim is offered on the row itself and the number they just
     recognized is carried along for them. -->
{listings.map((l) => (
  <div
    class:list={['list-row', { 'is-claimed': isClaimed(l) }]}
    data-city={l.city}
    data-search={`${l.licensee_name} ${l.business_name ?? ''} ${l.city} ${l.license_number}`.toLowerCase()}
  >
    <div>
      <a class="name" href={inspectorPath(l.county, l.city, l.license_number, l.licensee_name)}>{l.business_name || l.licensee_name}</a>
      <div class="role">
        {l.business_name ? `${l.licensee_name} · ` : ''}Licensed home inspector
      </div>
    </div>
    <div>{l.city}</div>
    <div class="lic-num">{l.license_number}</div>
    <div class="tags">
      {l.specialties.length > 0 ? (
        l.specialties.map((s) => <span class="tag">{s}</span>)
      ) : (
        <span class="tag tag-empty">—</span>
      )}
    </div>
    {isClaimed(l) ? (
      <div class="row-contact">
        <span class="claimed-mark">Claimed</span>
        {l.phone && (
          <a
            class="row-phone phone-link"
            href={`tel:${l.phone.replace(/[^\d+]/g, '')}`}
            data-listing-id={l.id}
            data-page-context={pageContext}
          >
            {l.phone}
          </a>
        )}
        {l.website && (
          <a class="row-web" href={l.website} target="_blank" rel="noopener">
            {websiteLabel(l.website)} ↗
          </a>
        )}
        {!l.phone && !l.website && <span class="claimed-note">Responds to requests</span>}
      </div>
    ) : (
      <div class="claimed-status">
        <span class="unclaimed-mark">Unclaimed</span>
        <span class="claimed-note">No contact on file. Free to claim.</span>
      </div>
    )}
    {/* An unclaimed listing has no contact path, and that is the point:
        nothing is on file. The only action on an unclaimed row is the claim,
        which goes straight to sign-in with the license carried along. */}
    <div>
      {isClaimed(l) ? (
        <button
          class="request-btn-row"
          data-listing-id={l.id}
          data-license={l.license_number}
          data-name={l.business_name || l.licensee_name}
          data-page-context={pageContext}
          data-county={county.slug}
        >
          Request this inspector
        </button>
      ) : (
        <a
          href={`/claim/?license=${l.license_number}`}
          class="claim-btn-row claim-link"
          data-license={l.license_number}
          data-county={county.slug}
        >
          Claim this listing
        </a>
      )}
    </div>
  </div>
))}
