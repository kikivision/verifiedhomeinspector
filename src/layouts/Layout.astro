---
import { counties } from '../lib/counties';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentCountySlug?: string;
  /** For pages that only make sense to one signed-in person, like the dashboard. */
  noindex?: boolean;
}

const { title, description, currentCountySlug, noindex = false } = Astro.props;

// The nav used bare fragments, which only work on a county page. On /privacy/,
// /terms/ and the confirmation pages they resolved against the current URL —
// /privacy/#browse — and went nowhere. These are absolute, and a same-page
// fragment still scrolls rather than reloading.
//
// Off a county page there is no county to send anyone to, and picking one for
// them would be a guess. The homepage's own county selector is the honest
// destination, so that is where the two county-shaped links point instead.
const inspectors = currentCountySlug ? `/fl/${currentCountySlug}/#all-inspectors` : '/#browse';
// One page explains the offer and its price for every county, so the nav goes
// there rather than to a county's claim panel. The panel still exists on each
// county page for an inspector who is already looking at their own row.
const listYours = '/for-inspectors/';

// Absolute URLs, because og:image and og:url are read by crawlers that have no
// page to resolve a relative path against. Astro.site comes from `site` in
// astro.config.mjs, so this follows the canonical host rather than repeating it.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <!-- Pages passed a description before this existed and Astro discarded it
       silently, so every page shipped without one and Google wrote its own
       from whatever text it found first. -->
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex" />}
  <!-- The site shipped with Astro's default logo, and with no icon link at
       all: browsers were finding /favicon.ico only by convention. Three
       entries is the whole modern set — .ico for browsers that still ask for
       it by convention, .svg for the ones that prefer it and get a crisp icon
       at any size, and the Apple one for a home-screen bookmark, which iOS
       renders on an opaque tile of its own. -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!-- Tints the mobile browser chrome, so this matches the sticky header the
       chrome sits against, not the icon. -->
  <meta name="theme-color" content="#FCFBF6" />
  <!-- Without these a shared link renders as a bare URL: no title, no image,
       no description. The site had none at all, so every link texted or posted
       looked broken regardless of how finished the page behind it was.
       og:title and og:description reuse the page's own, so a county page
       previews as that county rather than as the site in general. The image is
       one shared file rather than per-page: at preview size a county name is
       unreadable anyway, and a second image is a second thing to keep current.
       twitter:card is what promotes the preview from a thumbnail to the large
       format, and is read by more than Twitter. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Verified Home Inspector" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={pageUrl.href} />
  <meta property="og:image" content={ogImage.href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Verified Home Inspector — find a licensed home inspector in Florida" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage.href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <slot name="head" />
</head>
<body>
  <header>
    <div class="wrap header-row">
      <a href="/" class="wordmark">Verified<span>Home Inspector</span></a>
      <!-- The nav needs about 407px laid out in a row, which does not fit a phone.
           Below the breakpoint it collapses behind this button. The listing page
           runs to tens of thousands of pixels, so these in-page jumps are worth
           more on a phone than on a desktop, which is why they collapse rather
           than move to the footer. -->
      <button
        type="button"
        class="nav-toggle"
        id="navToggle"
        aria-expanded="false"
        aria-controls="primaryNav"
      >
        <span class="nav-toggle-bars" aria-hidden="true"></span>
        Menu
      </button>
      <nav id="primaryNav">
        <!-- Three, not four, and each one lands where its label says.
             "Browse Inspectors" pointed at #browse, which is the featured row:
             the one link a homeowner would click to see inspectors landed on
             two empty paid slots. It points at the list now.
             "For Homebuyers" pointed at the h1, so it scrolled to the top of
             the page you were already on, which the wordmark already does. -->
        <a href={inspectors}>Find an inspector</a>
        <a href="/insurance-inspections/">Insurance inspections</a>
        <a href={listYours} class="nav-cta">List your business</a>
      </nav>
    </div>
    <div class="wrap county-bar">
      <label for="countySelect">County:</label>
      <select id="countySelect">
        {/* The homepage passes no current county, and without this the browser
            selects the first option — so the bar claimed "Pinellas County" on a
            page that is not Pinellas, and choosing Pinellas then fired no
            change event and went nowhere. */}
        {!currentCountySlug && <option value="" selected>Choose a county…</option>}
        {counties.map((c) => (
          <option value={c.slug} selected={c.slug === currentCountySlug}>
            {c.name}{c.status === 'coming_soon' ? ' — coming soon' : ''}
          </option>
        ))}
      </select>
    </div>
  </header>

  <slot />

  <footer>
    <div class="wrap">
      <p>
        Verified Home Inspector is an independent directory built from publicly available
        Florida Department of Business and Professional Regulation (DBPR) license records.
        Inclusion is not an endorsement, and license status should be independently verified
        with the DBPR before hiring.
      </p>
      <p class="footer-meta">
        <span>A Sunstate Bay Ventures LLC property.</span>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </p>
    </div>
  </footer>

  <script>
    import { initAnalytics } from '../lib/gtag';

    // Every page, not just the county listing. The two form success pages are
    // the only proof a submission actually completed, and until this moved here
    // they loaded with no analytics at all — so those page views were invisible.
    initAnalytics();

    const navToggle = document.getElementById('navToggle');
    const primaryNav = document.getElementById('primaryNav');

    function setNavOpen(open: boolean) {
      navToggle?.setAttribute('aria-expanded', String(open));
      primaryNav?.classList.toggle('is-open', open);
    }

    navToggle?.addEventListener('click', (event) => {
      event.stopPropagation();
      setNavOpen(navToggle.getAttribute('aria-expanded') !== 'true');
    });

    // Tapping away and pressing Escape are both what people try first when a
    // menu is open. Without them the toggle is the only way out, and it looked
    // like the button that had opened the menu rather than one that would
    // close it.
    document.addEventListener('click', (event) => {
      if (navToggle?.getAttribute('aria-expanded') !== 'true') return;
      if (primaryNav?.contains(event.target as Node)) return;
      setNavOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setNavOpen(false);
    });
    // Every link here is an in-page jump, so the menu has to close itself —
    // nothing navigates away to close it.
    primaryNav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setNavOpen(false));
    });

    const select = document.getElementById('countySelect') as HTMLSelectElement;
    select?.addEventListener('change', () => {
      if (!select.value) return;
      window.location.href = `/fl/${select.value}/`;
    });
  </script>
</body>
</html>
